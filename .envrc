# VeriFast development environment.
#
#   Nix    -> native toolchain and the entire OCaml stack: gcc, cmake, ninja,
#             capnproto, LLVM/Clang 16, OCaml 4.14 + libraries, Z3 4.8.5 (with
#             OCaml bindings), Rocq 9.0 + Iris 4.3, capnpc-ocaml-decoder
#   rustup -> nightly-2025-11-25 (pinned by rust-toolchain.toml), left untouched
#
# All build configuration (Z3_DLL_DIR, CAPNP_*, WITHOUT_LABLGTK, ...) lives in
# flake.nix, so `nix develop` works without direnv. What remains here depends on
# the host or on the checkout's location, which a pure flake evaluation cannot see.

# ------------------------------------------------------------------ Nix ----
_vf_host_path="$PATH"

use flake

# `nix print-dev-env` REPLACES PATH with the pure derivation PATH -- unlike
# `nix develop`, which appends the ambient one. Neither direnv's use_flake nor
# nix-direnv's restores it, and without the restore we lose ~/.cargo/bin and
# the rustup shims, i.e. the toolchain deliberately kept outside Nix. Nix tools
# take precedence; the host PATH is appended.
if [ -n "$_vf_host_path" ]; then
  export PATH="$PATH:$_vf_host_path"
fi
unset _vf_host_path

# ----------------------------------------------------------------- Rust ----
_cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
[ -d "$_cargo_bin" ] && PATH_add "$_cargo_bin"
unset _cargo_bin

# VeriFast's own bin/ -- this is what setenv.sh does, minus the /tmp/vfdeps part.
PATH_add bin