# VeriFast development environment.
#
#   Nix    -> native toolchain: gcc, cmake, ninja, capnproto, LLVM/Clang 16,
#             Rocq 9.0 + Iris 4.3, capnpc-ocaml-decoder
#   opam   -> the entire OCaml stack, in the project-local ./_opam switch
#   rustup -> nightly-2025-11-25 (pinned by rust-toolchain.toml), left untouched
#
# Nothing lives under /tmp, and no tracked file is patched: every override below
# is an environment variable the upstream build already reads.

# ------------------------------------------------------------------ Nix ----
_vf_host_path="$PATH"

use flake

# `nix print-dev-env` REPLACES PATH with the pure derivation PATH -- unlike
# `nix develop`, which appends the ambient one. Neither direnv's use_flake nor
# nix-direnv's restores it, and without the restore we lose /usr/bin (opam is
# /usr/bin/opam) and ~/.cargo/bin, i.e. exactly the two toolchains deliberately
# kept outside Nix. Nix tools take precedence; the host PATH is appended.
if [ -n "$_vf_host_path" ]; then
  export PATH="$PATH:$_vf_host_path"
fi
unset _vf_host_path

# ---------------------------------------------------------------- OCaml ----
if [ -d "$PWD/_opam" ]; then
  eval "$(opam env --switch="$PWD" --set-switch)"
fi

# ----------------------------------------------------------------- Rust ----
_cargo_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
[ -d "$_cargo_bin" ] && PATH_add "$_cargo_bin"
unset _cargo_bin

# VeriFast's own bin/ -- this is what setenv.sh does, minus the /tmp/vfdeps part.
PATH_add bin

# ------------------------------------------------------------------ Z3 ----
# src/dune:7 hardcodes the findlib package name `Z3` (capital Z), which is how
# Z3's own `make install` registers it. opam installs it lowercase as `z3`.
# Symlinking the real package directory under the capitalised name gives a true
# alias -- findlib derives the package name from the directory name, so the
# archives come along too (a META with only `requires` would not survive
# `(implicit_transitive_deps false)` in src/dune-project).
if command -v ocamlfind >/dev/null 2>&1; then
  _z3dir="$(ocamlfind query z3 2>/dev/null || true)"
  if [ -n "$_z3dir" ]; then
    mkdir -p "$PWD/.direnv/findlib-shim"
    ln -sfn "$_z3dir" "$PWD/.direnv/findlib-shim/Z3"
    export OCAMLPATH="$PWD/.direnv/findlib-shim${OCAMLPATH:+:$OCAMLPATH}"

    export Z3_DLL_DIR="$_z3dir"

    # opam builds z3 with `mk_make.py --ml --staticlib`: the switch has
    # libz3-static.a and libz3ml.a but NO libz3.so, and none is needed because
    # Z3 is linked into bin/verifast statically. GNUmakefile:111 nevertheless
    # puts ../bin/libz3.so in $(Z3DEPS), a prerequisite of vfconsole.exe
    # (:504) and vfide.exe (:485), and rule :168 tries to cp it. Clear the
    # variable: assignments carried in MAKEFLAGS act like command-line
    # overrides, which beat the makefile's own `:=`.
    if [ ! -e "$_z3dir/libz3.so" ]; then
      export MAKEFLAGS="Z3DEPS=${MAKEFLAGS:+ $MAKEFLAGS}"
    fi
  fi
  unset _z3dir
fi

# Rocq 9.0 renamed COQPATH -> ROCQPATH; nixpkgs' coq setup hook still sets the
# old one, which makes every coqc invocation emit a deprecation warning.
if [ -n "$COQPATH" ]; then export ROCQPATH="$COQPATH"; fi

# --------------------------------------------------------------- build ----
export WITHOUT_LABLGTK=yes

export OCAMLOPT_CCLIB_FLAGS='-Wl,-rpath=$ORIGIN'

# Cap'n Proto include dir, under both names the tree uses:
#   CAPNP_INC_DIR -- read by src/rust_frontend/vf_mir/dune:11 and
#                    vf_mir_decoder/dune:12, but never exported by the makefile
#                    (GNUmakefile:256-264 exports only BIN/INCLUDE/LIBS), so
#                    upstream silently compiles schemas with -I ""
#   CAPNP_INCLUDE -- read by src/cxx_frontend/stubs/dune:9, which otherwise
#                    defaults to the *literal string* "CAPNP_INCLUDE"
if [ -n "$CAPNP_PREFIX" ]; then
  export CAPNP_INC_DIR="$CAPNP_PREFIX/include"
  export CAPNP_INCLUDE="$CAPNP_PREFIX/include"
  export CAPNP_LIBS="$CAPNP_PREFIX/lib"
fi
export CAPNP_BIN="$(command -v capnp 2>/dev/null || true)"

# bin/vf-rust-mir-exporter links librustc_driver-*.so from the rustup sysroot,
# and that library needs libz.so.1 -- which the Nix loader will not find on its
# own (the exporter's own RUNPATH does not apply to its dependencies' deps).
# rust_fe.ml:120 *prepends* the sysroot to LD_LIBRARY_PATH rather than
# replacing it, so an entry set here survives into the exporter process.
if [ -n "$VF_RUNTIME_LIB_PATH" ]; then
  export LD_LIBRARY_PATH="$VF_RUNTIME_LIB_PATH${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

# ------------------------------------------------------------ overrides ----
if [ -f .envrc.local ]; then
  source_env .envrc.local
fi
