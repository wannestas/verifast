// See https://github.com/btj/vf-rust-aliasing/tree/master/README.md
// VeriFast aims to soundly (but not necessarily completely) enforce the Tree Borrows aliasing restrictions model by Neven Villani and Ralf Jung.
// The current design is highly incomplete (e.g., it does not support two-phase borrows).

/*@

fix ref_origin_provenance(prov: pointer_provenance) -> pointer_provenance;
fix ref_origin<t>(p: *t) -> *t { pointer_ctor(ref_origin_provenance((p as pointer).provenance), (p as pointer).address, (p as pointer).metadata) as *t }

lem_auto(ptr_provenance_min_addr(ref_origin_provenance(prov))) ref_origin_min_addr(prov: pointer_provenance);
    req true;
    ens ptr_provenance_min_addr(ref_origin_provenance(prov)) == ptr_provenance_min_addr(prov);

lem_auto(ptr_provenance_max_addr(ref_origin_provenance(prov))) ref_origin_max_addr(prov: pointer_provenance);
    req true;
    ens ptr_provenance_max_addr(ref_origin_provenance(prov)) == ptr_provenance_max_addr(prov);

lem_auto(ref_origin(ref_origin(p))) ref_origin_ref_origin(p: *_);
    req true;
    ens ref_origin(ref_origin(p)) == ref_origin(p);

pred ref_init_perm<T>(child: *T; parent: *T);
pred ref_padding_init_perm<T>(child: *T; parent: *T);

lem_auto ref_init_perm_inv<T: ?Sized>();
    req ref_init_perm::<T>(?child, ?parent);
    ens ref_init_perm::<T>(child, parent) &*& ref_origin(child) == ref_origin(parent);

// parent is an input: fractions with different parents must not merge.
// Notably this occurs when you only use part of a ref_end_token to merge it with another using the ref_end transitive lemma
pred ref_end_token<T>(child: *T, parent: *T;);
pred ref_padding_end_token<T>(child: *T, parent: *T;);

pred ref_initialized<T>(p: *T;);
pred ref_padding_initialized<T>(p: *T;);

pred_ctor ref_initialized_<T>(p: *T)(;) = ref_initialized(p);
pred_ctor ref_padding_initialized_<T>(p: *T)(;) = ref_padding_initialized(p);

lem init_ref_readonly<T>(child: *T, coef: real); // Use this if you don't need interior mutability.
    req ref_init_perm(child, ?parent) &*& [?f](*parent |-> ?v) &*& 0 < coef &*& coef < 1;
    ens [f*coef]ref_end_token(child, parent) &*& [f*(1-coef)](*parent |-> v) &*& [f*coef](*child |-> v) &*& [f*coef]ref_initialized(child);

lem end_ref<T>(child: *T);
    req [?q]ref_end_token::<T>(child, ?parent) &*& [q](*child |-> ?v) &*& [q]ref_initialized(child);
    ens [q](*parent |-> v);

// Kind of nasty, but ensuring  there aren't multiple `ref_end_token<T>(child, ?parent)` while having a ref_end_trans lemma seems even nastier
lem end_ref_to<T>(child: *T, parent: *T)
    req [?q]ref_end_token::<T>(child, parent) &*& [q](*child |-> ?v) &*& [q]ref_initialized(child);
    ens [q](*parent |-> v);
{
    end_ref(child);
}

lem ref_end_token_trans<T>(child: *T);
    req [?q]ref_end_token::<T>(child, ?parent) &*& [q]ref_end_token::<T>(parent, ?grandparent) &*& [q]ref_initialized(parent);
    ens [q]ref_end_token::<T>(child, grandparent);

lem ref_end_token_trans_to<T>(child: *T, parent: *T, grandparent: *T)
    req [?q]ref_end_token::<T>(child, parent) &*& [q]ref_end_token::<T>(parent, grandparent) &*& [q]ref_initialized(parent);
    ens [q]ref_end_token::<T>(child, grandparent);
{
    ref_end_token_trans(child);
}

@*/

